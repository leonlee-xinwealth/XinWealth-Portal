{
  "note": "Shared expectations for _shared/cashflow/periods.ts. Read by BOTH the Deno test (periods.test.ts) and the vitest one (components/advisor/__tests__/cashflowPeriods.test.ts). One file so the browser and the edge function can never drift on the 口径 that produces every figure in the report. Figures marked REAL come from live client records.",
  "cases": [
    {
      "name": "REAL Lee Wei Qi — June is the only complete month",
      "why": "Five expenses were entered in June and one more in July. Under month-actual semantics June's position is RM 1,420, and that is what a June basis must report.",
      "rows": [
        { "direction": "inflow", "amount": 2577, "frequency": "monthly", "period_month": "2026-06-01", "category": "salary" },
        { "direction": "outflow", "amount": 580, "frequency": "monthly", "period_month": "2026-06-01", "category": "personal" },
        { "direction": "outflow", "amount": 340, "frequency": "monthly", "period_month": "2026-06-01", "category": "transportation" },
        { "direction": "outflow", "amount": 200, "frequency": "monthly", "period_month": "2026-06-01", "category": "personal" },
        { "direction": "outflow", "amount": 200, "frequency": "monthly", "period_month": "2026-06-01", "category": "miscellaneous" },
        { "direction": "outflow", "amount": 100, "frequency": "monthly", "period_month": "2026-06-01", "category": "personal" },
        { "direction": "outflow", "amount": 128, "frequency": "monthly", "period_month": "2026-07-01", "category": "household" }
      ],
      "basis": { "year": 2026, "from_month": 6, "to_month": 6 },
      "expect": {
        "monthly_income": 2577,
        "monthly_expenses": 1420,
        "annual_income": 30924,
        "annual_expenses": 17040,
        "basis_months": 1,
        "months_with_data": [6],
        "annual_items_income": 0,
        "annual_items_expenses": 0
      },
      "ytd": { "year": 2026, "income": 2577, "expenses": 1548, "surplus": 1029, "months_with_data": [6, 7] }
    },
    {
      "name": "REAL Lee Wei Qi — averaging June and July halves the position",
      "why": "July holds one row (RM 128) against June's five. Averaging is arithmetically right and probably not what the advisor wants, which is exactly why months_with_data and the per-month entry counts are surfaced instead of being resolved silently.",
