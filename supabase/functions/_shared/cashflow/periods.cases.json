      "expect": {
        "monthly_income": 6533.333333333333,
        "monthly_expenses": 0,
        "annual_income": 78400,
        "annual_expenses": 0,
        "basis_months": 2,
        "months_with_data": [6, 7],
        "annual_items_income": 18400,
        "annual_items_expenses": 0
      },
      "ytd": { "year": 2026, "income": 28400, "expenses": 0, "surplus": 28400, "months_with_data": [3, 6, 7] }
    },
    {
      "name": "the user's own example: RM 6,000 in June and RM 4,000 in July",
