        { "direction": "inflow", "amount": 18400, "frequency": "annual", "period_month": "2026-03-01", "category": "bonus" },
        { "direction": "inflow", "amount": 6000, "frequency": "monthly", "period_month": "2026-06-01", "category": "salary" },
